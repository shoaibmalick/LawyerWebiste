# Copy to .env.local and fill in per client. See CLAUDE.md New-Client Onboarding Checklist.

# Postgres connection string (Supabase for real clients, local Docker Postgres for dev).
# On Supabase use the CONNECTION POOLING url (port 6543), not the direct one
# (5432): each serverless instance opens its own pool, and direct connections
# run out under exactly the traffic you want.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/website_starter_kit?schema=public"

# Connections per instance. Defaults to 5, which suits many short-lived
# serverless instances. Raise it for a traditional always-on server where one
# process serves every request.
DATABASE_POOL_MAX="5"

# Resend (transactional email: booking confirmations, lead notifications).
#
# These are now the *fallback*, not the only option. The business owner can
# configure Resend or their own SMTP mailbox from /dashboard/settings, and that
# takes precedence; these apply when the stored provider is "Use the server's
# configuration", which is the default.
RESEND_API_KEY=""
RESEND_FROM_EMAIL="Business Name <hello@example.com>"

# Auth.js — generate a fresh secret per client, e.g.:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=""

# Dev-only: the seed script creates one admin user with these credentials.
# Deliberately blank. These were the only pre-filled values in this file, which
# meant anyone who copied it and filled in the empty ones shipped a live
# admin account on a password that was in a public template — and
# "changeme123" satisfies the 8-character minimum, so nothing complained.
# Leave both unset and the seed skips the admin user entirely.
#
# For a real client, set the admin password directly in that client's database
# rather than here; see CLAUDE.md's New-Client Onboarding Checklist.
SEED_ADMIN_EMAIL=""
SEED_ADMIN_PASSWORD=""

# Stripe (per-client account — see CLAUDE.md). Only required if a service in
# config/content/services.ts has a depositAmount AND the "payments" feature
# flag is on; leaving these unset with the flag on makes booking fail closed
# (503), not silently skip payment.
#
# These are now the *fallback*, not the only option — the same arrangement the
# Resend variables above have. The business connects its own Stripe account at
# /dashboard/settings, and a stored key takes precedence over these. Leave them
# set for a client who should not have to think about payments, and blank for
# one who connects their own account.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Anthropic (ai-chatbot feature). Unlike Stripe, chat unavailability fails
# soft — leaving this unset shows a "call us" fallback instead of erroring.
ANTHROPIC_API_KEY=""
