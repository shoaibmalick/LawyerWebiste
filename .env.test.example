# Copy to .env.test. Points tests at a dedicated database, never the dev one —
# integration tests wipe tables between runs. See CLAUDE.md "Testing".
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/website_starter_kit_test?schema=public"

# Required by lib/secret-box.ts, which encrypts the mail credentials the owner
# stores from /dashboard/settings. Any non-empty value works here — nothing in
# the test database outlives the run.
AUTH_SECRET="test-auth-secret-not-used-anywhere-real"

# lib/env.ts validates this at import time, so any test that transitively
# imports it (app/robots.ts, lib/structured-data.ts, anything reading siteUrl)
# fails without it. CI supplies the same value as a job-level env var; setting
# it here too keeps a local `npm test` honest rather than green-only-in-CI.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
